#!/usr/bin/env bash
# Swarm — agent worktrees + human integration inbox (submission markers).
# Config: swarm.json (walk up from $PWD). Skill template: swarm/skills/swarm/SKILL.md
set -euo pipefail

SWARM_VERSION="0.4.0"
SWARM_CONFIG_NAME="swarm.json"
CONFIG_VERSION=""
WORKTREES_DIR=""

# Set by load_swarm_config (except help/version/install bootstrap)
SWARM_ROOT=""
SWARM_CONFIG_PATH=""
REPOS_DIR=""
STATE_DIR=""
SUBMISSIONS_DIR=""
# Registered logical repo names.
REPOS_LIST=()
CLI_DIR=""
WP=""
BASE_REF="${WP_BASE_REF:-origin/main}"
DRY_RUN=0

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }

cli_dir() {
  local src="${BASH_SOURCE[0]}"
  local dir
  dir="$(cd "$(dirname "$src")" && pwd)"
  if [[ -L "$src" ]]; then
    src="$(readlink -f "$src")"
    dir="$(cd "$(dirname "$src")" && pwd)"
  fi
  printf '%s\n' "$dir"
}

CLI_DIR="$(cli_dir)"
# Bundled internal dependency — always next to this script
WP="$CLI_DIR/wp"
source "$CLI_DIR/lib/repos.sh"
CURRENT_REPO=""
SKILL_TEMPLATE="$CLI_DIR/skills/swarm/SKILL.md"

require_jq() {
  command -v jq >/dev/null 2>&1 || die "jq is required to read $SWARM_CONFIG_NAME (install jq)"
}

# Walk $PWD and parents for swarm.json. Sets SWARM_ROOT + SWARM_CONFIG_PATH.
# Returns 0 if found, 1 if not.
try_find_swarm_config() {
  local dir
  dir="$(pwd -P)"
  while true; do
    if [[ -f "$dir/$SWARM_CONFIG_NAME" ]] && ! is_copied_root_config "$dir"; then
      SWARM_ROOT="$dir"
      SWARM_CONFIG_PATH="$dir/$SWARM_CONFIG_NAME"
      return 0
    fi
    if [[ "$dir" == "/" ]]; then
      break
    fi
    local parent
    parent="$(dirname "$dir")"
    [[ "$parent" == "$dir" ]] && break
    dir="$parent"
  done
  return 1
}

# Walk $PWD and parents for swarm.json. Sets SWARM_ROOT + SWARM_CONFIG_PATH or dies.
find_swarm_config() {
  try_find_swarm_config || die "no $SWARM_CONFIG_NAME found in current directory or any parent"
}

# Resolve path relative to SWARM_ROOT; reject escapes outside root. May create dir.
resolve_under_root() {
  local rel="$1"
  local label="$2"
  [[ -n "$rel" ]] || die "invalid $SWARM_CONFIG_NAME: $label is empty"
  if [[ "$rel" == /* ]]; then
    die "invalid $SWARM_CONFIG_NAME: $label must be relative to SWARM_ROOT (got absolute: $rel)"
  fi
  case "$rel" in
    *..*) die "invalid $SWARM_CONFIG_NAME: $label must not contain '..' (got: $rel)" ;;
  esac
  mkdir -p "$SWARM_ROOT/$rel"
  local abs
  abs="$(cd "$SWARM_ROOT/$rel" && pwd -P)"
  case "$abs" in
    "$SWARM_ROOT"|"$SWARM_ROOT"/*) printf '%s\n' "$abs" ;;
    *) die "invalid $SWARM_CONFIG_NAME: $label escapes SWARM_ROOT ($abs)" ;;
  esac
}

# Like resolve_under_root but do not mkdir (for repos_dir which must already exist).
resolve_existing_under_root() {
  local rel="$1"
  local label="$2"
  [[ -n "$rel" ]] || die "invalid $SWARM_CONFIG_NAME: $label is empty"
  if [[ "$rel" == /* ]]; then
    die "invalid $SWARM_CONFIG_NAME: $label must be relative to SWARM_ROOT (got absolute: $rel)"
  fi
  case "$rel" in
    *..*) die "invalid $SWARM_CONFIG_NAME: $label must not contain '..' (got: $rel)" ;;
  esac
  local candidate="$SWARM_ROOT/$rel"
  [[ -d "$candidate" ]] || die "invalid $SWARM_CONFIG_NAME: $label does not exist: $rel"
  local abs
  abs="$(cd "$candidate" && pwd -P)"
  case "$abs" in
    "$SWARM_ROOT"|"$SWARM_ROOT"/*) printf '%s\n' "$abs" ;;
    *) die "invalid $SWARM_CONFIG_NAME: $label escapes SWARM_ROOT ($abs)" ;;
  esac
}

repo_authorized() {
  local repo="$1"
  local r
  for r in "${REPOS_LIST[@]}"; do
    [[ "$r" == "$repo" ]] && return 0
  done
  return 1
}

# Validate and load swarm.json already pointed to by SWARM_CONFIG_PATH / SWARM_ROOT.

load_swarm_config() {
  find_swarm_config
  load_swarm_config_from_path
}

require_wp() {
  [[ -x "$WP" ]] || die "bundled wp missing/not executable: $WP"
  export WP_SERVICES_DIR="$REPOS_DIR"
  export WP_WORKTREES_DIR="$WORKTREES_DIR"
  export WP_CONFIG_PATH="$SWARM_CONFIG_PATH"
}

# If DRY_RUN=1, print planned action and return 0 (caller returns). Else return 1.
dry_run_exit() {
  if [[ "$DRY_RUN" -eq 1 ]]; then
    info "DRY-RUN: $*"
    info "DRY-RUN: no changes made. Re-run without --dry-run to apply."
    return 0
  fi
  return 1
}

# Strip --dry-run from args; sets DRY_RUN and leaves remaining in _ARGS.
consume_dry_run_args() {
  _ARGS=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) DRY_RUN=1; shift ;;
      *) _ARGS+=("$1"); shift ;;
    esac
  done
}

usage() {
  cat <<'EOF'
swarm — named repos, isolated worktrees, and a human integration inbox

Setup:
  swarm init
  swarm add <path> [--name <name>]
  swarm migrate [--dry-run] [--yes]
  swarm install
  swarm install --path
  swarm install [directory] [--cursor] [--claude] [--codex] [--yes]

Inspect and navigate:
  swarm config
  swarm list [repo-name] [--all]
  swarm status [repo-name] [--sizes | --refresh-sizes]
  swarm path [repo-name] [work-ID]
  swarm open [repo-name] [work-ID] [--cursor | --claude | --codex]
  swarm check [repo-name] <work-ID>
  swarm review [repo-name] <work-ID>

Agent writes (--dry-run supported):
  swarm create [repo-name] <work-ID> [branch] [--from <ref>] [--track <remote-branch>] [--with-env <directory>]...
  swarm sync [repo-name] <work-ID>
  swarm submit [repo-name] <work-ID>

Human writes:
  swarm integrate [repo-name] <work-ID> [-m "message"] [--dry-run]
  swarm remove [repo-name] <work-ID> [--confirm] [-d] [--dry-run]
    Preview by default; --confirm also requires interactive approval.

Agents MUST NOT run integrate or remove.
Worktree targets also accept repo-name___work-ID or an absolute managed path.
Omit the repo name inside its canonical checkout or a managed worktree.
path <repo-name> selects its canonical checkout; path alone uses the current repo.
open uses an explicit launcher or default_ide (cursor, claude, codex; initially blank).
create defaults to source checkout HEAD and branch task/<work-ID>.
--from / --track override the starting ref. Git is the worktree source of truth.

Config: nearest ancestor swarm.json; version 2, repos is a name-to-path object.
Paths: relative to the config, including "." for a workspace-root checkout.
Worktrees: .swarm/worktrees/<repo-name>___<work-ID>/
Submissions: .swarm/submissions/<repo-name>___<work-ID>
add prompts for a name; scripts must pass --name. No automatic suffixes.
Old v1 / early-v2 array configs require explicit swarm migrate.
Skill flags install locally (default: current directory), preserving existing skills.
Parent skill duplicates prompt; --yes accepts duplication, never overwrites.
install without skill flags configures a workspace; --path manages Bash PATH.
Meta (no workspace required): swarm help, swarm version.
EOF
}

# ---------------------------------------------------------------------------
# Identity / submissions
# ---------------------------------------------------------------------------


working_tree_state() {
  local dir="$1"
  if [[ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]]; then
    printf 'dirty\n'
  else
    printf 'clean\n'
  fi
}

ref_exists() {
  git -C "$1" rev-parse --verify --quiet "$2" >/dev/null 2>&1
}

trunk_ref() {
  # Prefer live canonical checkout HEAD (integrator trunk), else BASE_REF
  local canon="$1"
  if [[ -d "$canon" ]] && ( [[ -e "$canon/.git" ]] || [[ -d "$canon/.git" ]] ); then
    git -C "$canon" rev-parse HEAD
    return 0
  fi
  die "canonical repo missing: $canon"
}

mergeability_vs_trunk() {
  local wt="$1" canon="$2"
  local trunk
  trunk="$(trunk_ref "$canon")"
  local out rc
  if git merge-tree --write-tree -h >/dev/null 2>&1; then
    set +e
    out="$(git -C "$wt" merge-tree --write-tree HEAD "$trunk" 2>&1)"
    rc=$?
    set -e
    if [[ $rc -eq 0 ]]; then printf 'CLEAN\n'; else printf 'CONFLICT\n'; fi
    return 0
  fi
  local base
  base="$(git -C "$wt" merge-base HEAD "$trunk" 2>/dev/null || true)"
  [[ -n "$base" ]] || { printf 'UNKNOWN\n'; return 0; }
  set +e
  out="$(git -C "$wt" merge-tree "$base" HEAD "$trunk" 2>&1)"
  set -e
  if printf '%s\n' "$out" | grep -qE 'changed in both|CONFLICT|\+<<<<<<<'; then
    printf 'CONFLICT\n'
  else
    printf 'CLEAN\n'
  fi
}

branch_of() {
  git -C "$1" rev-parse --abbrev-ref HEAD
}

# Dashboard state for one worktree
swarm_state() {
  local wt="$1" id
  id="$(normalize_worktree_id "$wt")"
  local dirty merge canon
  dirty="$(working_tree_state "$wt")"
  if [[ "$dirty" == "dirty" ]]; then
    printf 'DIRTY\n'
    return 0
  fi
  canon="$(canonical_abs "$id")"
  merge="$(mergeability_vs_trunk "$wt" "$canon" 2>/dev/null || echo UNKNOWN)"
  if [[ "$merge" == "CONFLICT" ]]; then
    printf 'CONFLICT\n'
    return 0
  fi
  if is_submitted "$id"; then
    printf 'SUBMITTED\n'
    return 0
  fi
  printf 'ACTIVE\n'
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_config() {
  local md_path="$SWARM_ROOT/swarm.md"
  info "Current repo: ${CURRENT_REPO:-none}"
  if [[ -n "$CURRENT_REPO" ]]; then info "Canonical path: $(repo_abs "$CURRENT_REPO")"; fi
  info "Default IDE: ${DEFAULT_IDE:-none}"
  cat <<EOF
# Swarm Configuration

**Root:** \`$SWARM_ROOT\`
**Config:** \`$SWARM_CONFIG_PATH\`

\`\`\`json
$(jq '.' "$SWARM_CONFIG_PATH")
\`\`\`

---

# Swarm Workspace Instructions

EOF
  if [[ -f "$md_path" ]]; then
    cat "$md_path"
    # ensure trailing newline
    [[ -z "$(tail -c 1 "$md_path" 2>/dev/null || true)" ]] || printf '\n'
  else
    printf '_No workspace-specific instructions._\n'
  fi
}

# Collect .env paths, stopping only the subtree containing a regular .env.
collect_env_files() {
  local dir="$1" child name
  if [[ -f "$dir/.env" && ! -L "$dir/.env" ]]; then
    env_files+=("${dir#"$env_source"/}/.env")
    [[ "$dir" != "$env_source" ]] || env_files[${#env_files[@]}-1]=".env"
    return
  fi
  while IFS= read -r -d '' child; do
    name="${child##*/}"
    case "$name" in
      .git|node_modules|bower_components|vendor|.venv|venv|__pycache__) continue ;;
    esac
    collect_env_files "$child"
  done < <(find "$dir" -mindepth 1 -maxdepth 1 -type d ! -type l -print0 | sort -z)
}

# Reject symlinked destination parents before creating directories or copying.
env_destination_safe() {
  local path="$1" part current="$wt_path"
  local parts=()
  IFS='/' read -r -a parts <<< "$path"
  [[ ! -L "$current" ]] || return 1
  for part in "${parts[@]}"; do
    current="$current/$part"
    [[ ! -L "$current" ]] || return 1
  done
}

cmd_create() {
  require_wp
  local repo="" work_id="" branch="" from_ref="" track_ref=""
  local positional=() env_dirs=() env_files=()
  local usage_create='usage: swarm create <repo> <work-id> [branch] [--from <ref>] [--track <remote-branch>] [--with-env <directory>]... [--dry-run]'
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --with-env)
        [[ -n "${2:-}" && "$2" != -* ]] || die "--with-env requires a directory"
        env_dirs+=("$2")
        shift 2
        ;;
      --with-env=*)
        [[ -n "${1#--with-env=}" ]] || die "--with-env requires a directory"
        env_dirs+=("${1#--with-env=}")
        shift
        ;;
      --from)
        [[ -n "${2:-}" ]] || die "--from requires a ref
$usage_create"
        from_ref="$2"
        shift 2
        ;;
      --from=*)
        from_ref="${1#--from=}"
        [[ -n "$from_ref" ]] || die "--from requires a ref"
        shift
        ;;
      --track)
        [[ -n "${2:-}" ]] || die "--track requires a remote branch
$usage_create"
        track_ref="$2"
        shift 2
        ;;
      --track=*)
        track_ref="${1#--track=}"
        [[ -n "$track_ref" ]] || die "--track requires a remote branch"
        shift
        ;;
      -*)
        die "unknown flag: $1
$usage_create"
        ;;
      *)
        positional+=("$1")
        shift
        ;;
    esac
  done

  if [[ -n "$CURRENT_REPO" ]] && ! repo_authorized "${positional[0]:-}"; then
    positional=("$CURRENT_REPO" "${positional[@]}")
  fi
  repo="$(resolve_repo_selector "${positional[0]:-}")"
  work_id="${positional[1]:-}"
  branch="${positional[2]:-}"
  [[ -n "$repo" && -n "$work_id" ]] || die "$usage_create"
  [[ ${#positional[@]} -le 3 ]] \
    || die "unexpected argument: ${positional[3]}
$usage_create"
  repo_authorized "$repo" || die "repository '$repo' is not listed in $SWARM_CONFIG_PATH (repos)"

  if [[ -z "$branch" ]]; then
    branch="task/${work_id}"
  fi

  case "$branch" in
    origin/*|refs/*|remotes/*)
      die "refusing branch name '$branch' (looks like a starting ref).
Use: swarm create $repo $work_id --from $branch
or:  swarm create $repo $work_id --track $branch
or:  swarm create $repo $work_id task/${work_id} --track $branch"
      ;;
  esac

  validate_work_id "$work_id"
  is_checkout_root "$(repo_abs "$repo")" || die "registered repo unavailable: $repo"
  require_main_checkout "$(repo_abs "$repo")"
  local wt_path
  wt_path="$(worktree_abs "${repo}___${work_id}")"
  if [[ ! -d "$wt_path" ]] && git -C "$(repo_abs "$repo")" worktree list --porcelain | grep -Fx "worktree $wt_path" >/dev/null; then
    die "worktree metadata exists but checkout is missing: $wt_path; inspect swarm status"
  fi
  local env_source env_dir component current rel
  env_source="$(repo_abs "$repo")"
  for env_dir in "${env_dirs[@]}"; do
    [[ "$env_dir" != /* ]] || die "--with-env must be relative to the source repo: $env_dir"
    current="$env_source"
    local components=()
    IFS='/' read -r -a components <<< "$env_dir"
    for component in "${components[@]}"; do
      case "$component" in
        ..) die "--with-env must not escape the repo: $env_dir" ;;
        .|"") continue ;;
        .git|node_modules|bower_components|vendor|.venv|venv|__pycache__)
          die "--with-env excludes dependency and metadata directories: $env_dir" ;;
      esac
      current="$current/$component"
      [[ ! -L "$current" ]] || die "--with-env must not traverse symlinks: $env_dir"
    done
    [[ -d "$current" ]] || die "--with-env directory does not exist: $env_dir"
    collect_env_files "$current"
  done
  # Overlapping directory arguments must not copy the same file twice.
  local unique_env_files=() candidate seen
  for rel in "${env_files[@]}"; do
    seen=0
    for candidate in "${unique_env_files[@]}"; do
      [[ "$candidate" != "$rel" ]] || seen=1
    done
    [[ "$seen" == 1 ]] || unique_env_files+=("$rel")
  done
  env_files=("${unique_env_files[@]}")
  local plan="create worktree $wt_path on branch $branch"
  if [[ -n "$from_ref" ]]; then
    plan="$plan from $from_ref"
  elif [[ -n "$track_ref" ]]; then
    plan="$plan from $track_ref"
  else
    local source_head
    source_head="$(git -C "$(repo_abs "$repo")" rev-parse --verify 'HEAD^{commit}')" || die "source checkout has no committed HEAD; supply --from or commit first"
    plan="$plan from source checkout HEAD ($source_head)"
  fi
  if [[ -n "$track_ref" ]]; then
    plan="$plan tracking $track_ref"
  fi
  plan="$plan (via wp create)"
  if [[ "$DRY_RUN" == 1 ]]; then
    for rel in "${env_files[@]}"; do
      if ! env_destination_safe "$rel" || [[ -e "$wt_path/$rel" ]]; then
        info "skip existing or symlinked env destination: $wt_path/$rel"
      else
        info "copy env: $env_source/$rel -> $wt_path/$rel"
      fi
    done
  fi
  if dry_run_exit "$plan"; then
    return 0
  fi

  local wp_args=("$repo" "$work_id" "$branch")
  [[ -n "$from_ref" ]] && wp_args+=(--from "$from_ref")
  [[ -n "$track_ref" ]] && wp_args+=(--track "$track_ref")
  WP_TARGET_WORKTREE="$wt_path" "$WP" create "${wp_args[@]}"
  for rel in "${env_files[@]}"; do
    if ! env_destination_safe "$rel" || [[ -e "$wt_path/$rel" ]]; then
      info "skip existing or symlinked env destination: $wt_path/$rel"
      continue
    fi
    mkdir -p "$(dirname "$wt_path/$rel")"
    cp -n -- "$env_source/$rel" "$wt_path/$rel"
    info "copied env: $rel"
  done
}

cmd_sync() {
  require_wp
  local id
  id="$(resolve_work_target "$@")"
  local wt
  wt="$(ensure_worktree "$id")"
  local plan="merge integration base into $(branch_of "$wt") in $wt"
  if is_submitted "$id"; then
    plan="$plan; clear submission marker $SUBMISSIONS_DIR/$id"
  fi
  if dry_run_exit "$plan"; then
    return 0
  fi
  if is_submitted "$id"; then
    warn "clearing submission marker (sync may change branch tip)"
    clear_submission "$id"
  fi
  "$WP" sync "$wt"
}

cmd_check() {
  local id wt canon branch dirty merge ahead behind
  id="$(resolve_work_target "$@")"
  wt="$(ensure_worktree "$id")"
  canon="$(canonical_abs "$id")"
  branch="$(branch_of "$wt")"
  dirty="$(working_tree_state "$wt")"
  merge="$(mergeability_vs_trunk "$wt" "$canon")"

  ahead="$(git -C "$wt" rev-list --count "$(trunk_ref "$canon")"..HEAD 2>/dev/null || echo 0)"
  behind="$(git -C "$wt" rev-list --count HEAD.."$(trunk_ref "$canon")" 2>/dev/null || echo 0)"

  cat <<EOF
Worktree:     ${id}  (${wt#"$SWARM_ROOT"/})
Branch:       $branch
Trunk:        $canon (HEAD)

Working tree: $dirty
Ahead:        $ahead commits
Behind:       $behind commits
Mergeability: $merge
Submitted:    $(is_submitted "$id" && echo yes || echo no)
EOF

  printf '\n'
  if [[ "$dirty" != "clean" ]]; then
    info "Action: COMMIT — clean the worktree before submit."
    return 1
  fi
  if [[ "$merge" == "CONFLICT" ]]; then
    info "Action: SYNC REQUIRED — swarm sync $id"
    return 1
  fi
  if is_submitted "$id"; then
    info "Action: NONE — already SUBMITTED (awaiting human review)."
    return 0
  fi
  info "Action: READY TO SUBMIT — swarm submit $id"
  return 0
}

cmd_submit() {
  local id wt canon dirty merge
  id="$(resolve_work_target "$@")"
  wt="$(ensure_worktree "$id")"
  canon="$(canonical_abs "$id")"
  dirty="$(working_tree_state "$wt")"
  [[ "$dirty" == "clean" ]] || die "worktree is dirty; commit before submit"
  merge="$(mergeability_vs_trunk "$wt" "$canon")"
  if [[ "$merge" == "CONFLICT" ]]; then
    die "conflicts vs current trunk — run: swarm sync $id"
  fi
  if [[ "$merge" == "UNKNOWN" ]]; then
    die "could not determine mergeability vs trunk"
  fi
  local ahead
  ahead="$(git -C "$wt" rev-list --count "$(trunk_ref "$canon")"..HEAD 2>/dev/null || echo 0)"
  [[ "${ahead:-0}" -gt 0 ]] || die "no commits ahead of trunk — nothing to submit"

  if dry_run_exit "touch $SUBMISSIONS_DIR/$id (SUBMITTED); $ahead commit(s) ahead of trunk"; then
    return 0
  fi

  touch_submission "$id"
  info ""
  info "Inbox marker written. Human: swarm review $id"
}

cmd_list() {
  local selected="$CURRENT_REPO" all=0 explicit=""
  while [[ $# -gt 0 ]]; do
    case "$1" in --all) all=1 ;; -*) die "unknown list flag: $1" ;;
      *) [[ -z "$explicit" ]] || die "usage: swarm list [repo-name] [--all]"; explicit="$1" ;; esac
    shift
  done
  [[ "$all" == 0 || -z "$explicit" ]] || die "use a repo name or --all, not both"
  if [[ -n "$explicit" ]]; then selected="$(resolve_repo_selector "$explicit")"; fi
  [[ "$all" == 0 ]] || selected=""
  if [[ -n "$selected" ]]; then require_repo "$selected" >/dev/null; fi
  status_tables "$selected" 0 0 1
}

cmd_review() {
  local id wt canon branch dirty merge ahead
  id="$(resolve_work_target "$@")"
  wt="$(ensure_worktree "$id")"
  canon="$(canonical_abs "$id")"
  branch="$(branch_of "$wt")"
  dirty="$(working_tree_state "$wt")"
  merge="$(mergeability_vs_trunk "$wt" "$canon")"
  local trunk
  trunk="$(trunk_ref "$canon")"
  ahead="$(git -C "$wt" rev-list --count "$trunk"..HEAD 2>/dev/null || echo 0)"

  if ! is_submitted "$id"; then
    warn "no submission marker — reviewing anyway"
  fi

  local shortstat files
  shortstat="$(git -C "$wt" diff --shortstat "$trunk"...HEAD 2>/dev/null || true)"
  files="$(git -C "$wt" diff --name-only "$trunk"...HEAD 2>/dev/null | wc -l | tr -d ' ')"

  cat <<EOF
Submission:   $id

Branch:       $branch
Commits:      $ahead
Changes:      $files files
              ${shortstat:-"(no diff vs trunk)"}

Checks:
EOF

  if [[ "$dirty" == "clean" ]]; then
    info "  ✓ clean worktree"
  else
    info "  ✗ dirty worktree"
  fi

  if [[ "$merge" == "CLEAN" ]]; then
    info "  ✓ clean against current trunk ($canon)"
  elif [[ "$merge" == "CONFLICT" ]]; then
    info "  ✗ CONFLICT against current trunk"
  else
    info "  ? mergeability $merge"
  fi

  if is_submitted "$id"; then
    info "  ✓ submission marker present"
  else
    info "  ✗ not submitted"
  fi

  # Optional package checks (off by default — heavy on small hosts)
  if [[ "${SWARM_RUN_CHECKS:-0}" == "1" ]]; then
    info ""
    info "Package checks (SWARM_RUN_CHECKS=1):"
    if [[ -f "$wt/package.json" ]] && command -v pnpm >/dev/null 2>&1; then
      set +e
      (cd "$wt" && pnpm -r --filter './packages/**' exec true) >/dev/null 2>&1
      info "  (set filters yourself; no default full-repo typecheck — host memory)"
      set -e
      info "  · skipped heavy typecheck/lint/test by default"
    else
      info "  · no pnpm package.json or pnpm missing"
    fi
  else
    info "  · package typecheck/lint/test not run (export SWARM_RUN_CHECKS=1 to enable later)"
  fi

  info ""
  local submitted=0
  if is_submitted "$id"; then submitted=1; fi
  if [[ "$dirty" == "clean" && "$merge" == "CLEAN" && "$submitted" -eq 1 && "${ahead:-0}" -gt 0 ]]; then
    info "READY TO INTEGRATE"
    info "  swarm integrate $id"
    info "  then: swarm remove $id --confirm -d"
  elif [[ "$merge" == "CONFLICT" ]]; then
    info "NOT READY — hand back to agent:"
    info "  swarm sync $id   # then agent resubmits"
  else
    info "NOT READY — see checks above"
  fi
}

cmd_integrate() {
  local msg="" id=""
  local targets=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -m|--message) [[ $# -ge 2 ]] || die "--message requires text"; msg="$2"; shift 2 ;;
      --dry-run) DRY_RUN=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *) targets+=("$1"); shift ;;
    esac
  done
  [[ ${#targets[@]} -gt 0 ]] || die "usage: swarm integrate [repo-name] <work-id> [-m message]"

  id="$(resolve_work_target "${targets[@]}")"
  parse_id "$id"
  local wt canon branch dirty merge
  wt="$(ensure_worktree "$id")"
  canon="$(canonical_abs "$id")"
  [[ -d "$canon" ]] || die "canonical missing: $canon"

  is_submitted "$id" || die "no submission marker — agent must: swarm submit $id"

  dirty="$(working_tree_state "$wt")"
  [[ "$dirty" == "clean" ]] || die "feature worktree is dirty"

  # Unrelated untracked files are safe: merge checks for paths it would overwrite.
  # Keep tracked changes out of the integration commit.
  local canon_status
  canon_status="$(git -C "$canon" status --porcelain --untracked-files=no)" || die "cannot check canonical trunk status in $canon"
  [[ -z "$canon_status" ]] || die "canonical trunk has tracked changes — commit/stash in $canon first"

  merge="$(mergeability_vs_trunk "$wt" "$canon")"
  [[ "$merge" == "CLEAN" ]] || die "CONFLICT vs current trunk — agent must sync/resubmit"

  branch="$(branch_of "$wt")"
  [[ "$branch" != "HEAD" ]] || die "feature worktree is detached HEAD; checkout a branch before integrate"

  if [[ -z "$msg" ]]; then
    msg="${_work}: integrate ${branch}"
  fi

  if [[ "$DRY_RUN" == "1" ]]; then
    info "Untracked-file collisions are checked by Git during the actual merge."
  fi
  if dry_run_exit "in $canon: git merge --no-ff $branch -m \"$msg\"; clear $SUBMISSIONS_DIR/$id"; then
    return 0
  fi

  info "merging $branch into canonical $(basename "$canon") (--no-ff) …"
  git -C "$canon" merge --no-ff "$branch" -m "$msg"

  clear_submission "$id"

  info ""
  info "Integrated into $canon (merge commit; feature ancestry preserved)"
  info "Next: swarm remove $id --confirm -d"
  info "Note: orchestrator submodule pointer is YOUR responsibility if you publish this trunk tip."
}

# True if branch must never be deleted by swarm remove -d
is_protected_branch() {
  local repo="$1" branch="$2"
  local canon trunk_branch
  canon="$(repo_abs "$repo")"
  case "$branch" in
    main|master|HEAD|"") return 0 ;;
  esac
  if [[ -d "$canon" ]]; then
    trunk_branch="$(git -C "$canon" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    if [[ -n "$trunk_branch" && "$trunk_branch" != "HEAD" && "$branch" == "$trunk_branch" ]]; then
      return 0
    fi
  fi
  return 1
}

cmd_remove() {
  local delete_branch=0 confirm=0 preview=0
  local targets=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --confirm) confirm=1; shift ;;
      -d) delete_branch=1; shift ;;
      -D|--force|-f)
        die "swarm remove does not support force-delete (-D/--force); use --confirm [-d]"
        ;;
      --dry-run)
        preview=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *) targets+=("$1"); shift ;;
    esac
  done
  [[ ${#targets[@]} -gt 0 ]] || die "usage: swarm remove [repo-name] <work-id> [--confirm] [-d] [--dry-run]"

  local id wt repo_path branch
  id="$(resolve_work_target "${targets[@]}")"
  parse_id "$id"
  repo_path="$(canonical_abs "$id")"
  wt="$(ensure_worktree "$id")"
  [[ -d "$wt" ]] || die "worktree not found: $wt"
  [[ -d "$repo_path" ]] || die "canonical repo missing: $repo_path"

  branch="$(branch_of "$wt" 2>/dev/null || echo "HEAD")"

  local blocked=0 status status_entry ignored refs ref missing remote_refs=0 local_refs=0
  info "Would remove:"
  info "  Worktree folder (including all contents):"
  info $'\t'"$wt"
  if is_submitted "$id"; then
    info "  Submission: present — marker will be removed after successful worktree removal:"
    info $'\t'"$SUBMISSIONS_DIR/$id"
    info $'\tThis work will leave the submission inbox. Removing the marker itself does not delete commits.'
  else
    info "  Submission:"
    info $'\tNone present; no submission will be lost.'
  fi
  if [[ "$delete_branch" -eq 1 ]]; then
    info "  Local branch (git branch -d; remote branches untouched):"
    info $'\t'"$branch"
    if is_protected_branch "$_repo" "$branch"; then
      info "  BLOCKED: '$branch' is a protected/trunk branch"
      blocked=1
    fi
  else
    info "  Branch (kept; pass -d to request deletion):"
    info $'\t'"$branch"
  fi

  status="$(git -C "$wt" status --porcelain --untracked-files=all)" || die "cannot inspect worktree"
  ignored="$(git -C "$wt" ls-files --others --ignored --exclude-standard --directory --no-empty-directory)" || die "cannot inspect ignored files"
  if [[ -n "$status" ]]; then
    info "  Tracked changes / untracked files (Git status):"
    while IFS= read -r status_entry; do
      info $'\t'"$status_entry"
    done <<< "$status"
    info "  BLOCKED: commit/stash changes and move untracked files before removal"
    blocked=1
  else
    info "  Tracked changes / untracked files:"
    info $'\tclean'
  fi
  if [[ -n "$ignored" ]]; then
    local ignored_count=0 ignored_entry
    info "  Ignored files/directories (will also be deleted; directories collapsed):"
    while IFS= read -r ignored_entry; do
      ignored_count=$((ignored_count + 1))
      if [[ "$ignored_count" -le 10 ]]; then
        info $'\t'"$ignored_entry"
      fi
    done <<< "$ignored"
    if [[ "$ignored_count" -gt 10 ]]; then
      info $'\t'"… $((ignored_count - 10)) more ignored entries omitted"
    fi
  fi

  info ""
  info "  Commit safety (local branches and last-fetched remote refs; no fetch performed):"
  refs="$(git -C "$repo_path" for-each-ref --format='%(refname)' refs/heads refs/remotes)" || die "cannot inspect branch refs"
  local others=()
  while IFS= read -r ref; do
    [[ -n "$ref" && "$ref" != "refs/heads/$branch" ]] || continue
    others+=("$ref")
    if git -C "$wt" merge-base --is-ancestor HEAD "$ref"; then
      info "    All commits preserved by:"
      info $'\t'"$ref"
      case "$ref" in
        refs/remotes/*) remote_refs=$((remote_refs + 1)) ;;
        *) local_refs=$((local_refs + 1)) ;;
      esac
    fi
  done <<< "$refs"
  missing="$(git -C "$wt" rev-list --count HEAD --not "${others[@]}")" || die "cannot check commit reachability"
  info "    Commits absent from every other local branch / remote ref:"
  info $'\t'"$missing"
  if [[ "$remote_refs" -eq 0 ]]; then
    info "    No last-fetched remote ref contains all commits."
  fi
  if [[ "$local_refs" -eq 0 && "$remote_refs" -eq 0 && "$missing" == 0 ]]; then
    info "    Commits are preserved across other refs, but no single ref contains the tip."
  fi
  if [[ "$delete_branch" -eq 1 && "$missing" != 0 ]]; then
    info "  WARNING: branch has commits not preserved on another branch or remote ref."
  fi
  info ""
  if [[ "$delete_branch" -eq 1 && "$blocked" -eq 0 ]]; then
    local delete_base
    delete_base="$(git -C "$repo_path" rev-parse --verify "$branch@{upstream}" 2>/dev/null || git -C "$repo_path" rev-parse HEAD)" || die "cannot inspect deletion base"
    if git -C "$wt" merge-base --is-ancestor HEAD "$delete_base"; then
      info "  git branch -d:"
      info $'\tcommits merged into upstream (or canonical HEAD if no upstream).'
    else
      info "  WARNING: git branch -d would refuse: branch is not merged into upstream (or canonical HEAD if no upstream)."
      info "    Other refs may preserve commits; merge or keep the branch to proceed safely."
    fi
  fi
  info "  Branch deletion remains subject to git branch -d (merged/upstream and worktree checks)."
  info ""
  if [[ "$confirm" -eq 0 || "$preview" -eq 1 ]]; then
    info "Preview only; no changes made."
    info ""
    info "Re-run with --confirm (without --dry-run) for an interactive confirmation."
    return 0
  fi
  [[ "$blocked" -eq 0 ]] || die "removal blocked; resolve the issues above first"
  printf 'Are you sure you want to do this? [y/N] ' >&2
  local answer=""
  if [[ ! -t 0 ]]; then
    die "remove requires an interactive terminal to confirm (stdin is not a TTY)"
  fi
  read -r answer
  [[ "$answer" == "Y" || "$answer" == "y" ]] || die "aborted"

  info "removing worktree $wt"
  if ! git -C "$repo_path" worktree remove "$wt"; then
    die "git worktree remove failed (is the worktree dirty? commit/stash, then retry)
  branch left intact: $branch"
  fi

  clear_submission "$id"
  git -C "$repo_path" worktree prune

  if [[ "$delete_branch" -eq 1 ]]; then
    info "deleting local branch $branch (git branch -d) …"
    set +e
    git -C "$repo_path" branch -d "$branch"
    local rc=$?
    set -e
    if [[ $rc -ne 0 ]]; then
      warn "git branch -d failed — branch '$branch' was NOT deleted (not fully merged or still in use)"
      warn "worktree and submission marker were already removed"
      return 1
    fi
    info "deleted local branch $branch"
  fi

  info "done (remote branch left untouched)"
}

